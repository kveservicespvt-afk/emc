# Copy to .env and fill in real values before running the server.

# --- Database ---
# PLACEHOLDER — replace with a real Postgres connection string (Neon/Supabase/Render Postgres/etc.)
# before running `npx prisma migrate dev`.
DATABASE_URL="postgresql://user:password@host:5432/easemyclean?schema=public"

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# --- Auth ---
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# --- Razorpay (MOCK MODE in Pass 1 — no real keys needed yet) ---
RAZORPAY_MOCK_MODE=true
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- OTP / SMS (no real provider wired up yet — OTP is always logged server-side) ---
# Set to "true" to also return the OTP in the /api/auth/otp/request response and
# show a "DEV MODE" banner on the login screen — lets you demo/test the login flow
# (even on a live deploy) before a real SMS gateway exists. Set to "false"/unset
# before real customer launch.
SHOW_DEV_OTP=true
